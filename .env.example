# Copy this file to ".env" in the same folder and fill in real values.
# Never commit the real ".env" file (it is already in .gitignore).

# --- Spring profile & server ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL ---
# Matches the "db" service in docker-compose.yml (POSTGRES_DB is fixed to ftn_db there)
DB_URL=jdbc:postgresql://localhost:5432/ftn_db
DB_USER=postgres
DB_PASS=postgres

# --- pgAdmin (only used by the "pgadmin" service in docker-compose.yml) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- App / cookies / CORS ---
APP_COOKIE_SECURE=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
APP_CORS_ALLOWED_HEADERS=*

# --- JWT ---
# Generate a long random secret, e.g.: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-base64-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
