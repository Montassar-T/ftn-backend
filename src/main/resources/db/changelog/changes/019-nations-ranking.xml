<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="019-1" author="AlainBx20">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="nations_ranking"/></not>
        </preConditions>
        <createTable tableName="nations_ranking">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="athlete_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ranking_athlete"
                             references="athletes(id)"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints foreignKeyName="fk_ranking_event" references="events(id)"/>
            </column>
            <column name="best_time_ms" type="BIGINT"/>
            <column name="points_fina" type="DECIMAL(8,2)"/>
            <column name="rank_position" type="INTEGER"/>
            <column name="season" type="VARCHAR(10)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
