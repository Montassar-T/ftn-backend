<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="reservations-06" author="pools">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="reservations"/>
            <not><indexExists indexName="idx_reservations_pool_date"/></not>
        </preConditions>
        <createIndex indexName="idx_reservations_pool_date" tableName="reservations">
            <column name="pool_id"/>
            <column name="date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
