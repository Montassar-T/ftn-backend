<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="033-sujets-image-url" author="ftn-dev">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="sujets" columnName="image_url" />
            </not>
        </preConditions>
        <addColumn tableName="sujets">
            <column name="image_url" type="VARCHAR(500)" />
        </addColumn>
    </changeSet>

    <changeSet id="033-reponses-image-url" author="ftn-dev">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="reponses" columnName="image_url" />
            </not>
        </preConditions>
        <addColumn tableName="reponses">
            <column name="image_url" type="VARCHAR(500)" />
        </addColumn>
    </changeSet>

</databaseChangeLog>
