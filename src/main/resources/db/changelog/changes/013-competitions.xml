<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="013-1" author="MontassarTayari">
        <createTable tableName="competitions">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(50)"/>
            <column name="date_debut" type="DATE"/>
            <column name="date_fin" type="DATE"/>
            <column name="pool_id" type="BIGINT">
                <constraints foreignKeyName="fk_competition_pool" references="pools(id)"/>
            </column>
            <column name="statut" type="VARCHAR(50)" defaultValue="A_VENIR"/>
            <column name="description" type="TEXT"/>
            <column name="nb_participants" type="INT" defaultValueNumeric="0"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
