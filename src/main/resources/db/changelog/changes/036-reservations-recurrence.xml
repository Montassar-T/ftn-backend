<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="036-1" author="you">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="reservations" columnName="groupe_recurrence_id"/>
            </not>
        </preConditions>
        <addColumn tableName="reservations">
            <column name="groupe_recurrence_id" type="VARCHAR(36)"/>
        </addColumn>
    </changeSet>

    <changeSet id="036-2" author="you">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="reservations" columnName="groupe_recurrence_id"/>
        </preConditions>
        <createIndex tableName="reservations" indexName="idx_reservations_groupe_recurrence">
            <column name="groupe_recurrence_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>