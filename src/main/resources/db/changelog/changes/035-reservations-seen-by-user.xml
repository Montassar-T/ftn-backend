<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="reservations-07" author="pools">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="reservations"/>
            <not><columnExists tableName="reservations" columnName="seen_by_user"/></not>
        </preConditions>
        <addColumn tableName="reservations">
            <column name="seen_by_user" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
