<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="4-create-licences-table" author="MontassarTayari">
        <createTable tableName="licences">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="athlete_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_licence_athlete" references="athletes(id)"/>
            </column>

            <column name="club_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_licence_club" references="clubs(id)"/>
            </column>

            <column name="numero" type="VARCHAR(100)">
                <constraints unique="true"/>
            </column>

            <column name="type" type="VARCHAR(50)"/>

            <column name="date_debut" type="DATE"/>

            <column name="date_expiration" type="DATE"/>

            <column name="statut" type="VARCHAR(50)" defaultValue="EN_ATTENTE">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
