<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1-create-user-table" author="MontassarTayari">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="2-create-client-table" author="MontassarTayari">
        <createTable tableName="clients">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="phone_number" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="representative" type="VARCHAR(255)"/>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <createIndex indexName="idx_clients_phone_number" tableName="clients">
            <column name="phone_number"/>
        </createIndex>

        <createIndex indexName="idx_clients_name" tableName="clients">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="3-create-vehicle-brands-table" author="MontassarTayari">
        <createTable tableName="vehicle_brands">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <createIndex indexName="idx_vehicle_brands_name" tableName="vehicle_brands" unique="true">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="4-create-vehicle-models-table" author="MontassarTayari">
        <createTable tableName="vehicle_models">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="brand_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="vehicle_models"
                baseColumnNames="brand_id"
                referencedTableName="vehicle_brands"
                referencedColumnNames="id"
                constraintName="fk_vehicle_model_brand"/>

        <createIndex indexName="idx_vehicle_models_brand_id" tableName="vehicle_models">
            <column name="brand_id"/>
        </createIndex>

        <createIndex indexName="idx_vehicle_models_name" tableName="vehicle_models">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="5-create-vehicle-table" author="MontassarTayari">
        <createTable tableName="vehicles">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="model_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="registration" type="VARCHAR(255)"/>

            <column name="mileage" type="INT"/>

            <column name="vin" type="VARCHAR(17)">
                <constraints unique="true"/>
            </column>

            <column name="registration_date" type="DATE"/>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="vehicles"
                baseColumnNames="model_id"
                referencedTableName="vehicle_models"
                referencedColumnNames="id"
                constraintName="fk_vehicle_model"/>

        <addForeignKeyConstraint
                baseTableName="vehicles"
                baseColumnNames="client_id"
                referencedTableName="clients"
                referencedColumnNames="id"
                constraintName="fk_vehicle_client_id"/>

        <createIndex indexName="idx_vehicle_client_id" tableName="vehicles">
            <column name="client_id"/>
        </createIndex>

        <createIndex indexName="idx_vehicle_model_id" tableName="vehicles">
            <column name="model_id"/>
        </createIndex>

        <createIndex indexName="idx_vehicle_vin" tableName="vehicles" unique="true">
            <column name="vin"/>
        </createIndex>
    </changeSet>

    <changeSet id="6-create-mechanics-table" author="MontassarTayari">

        <createTable tableName="mechanics">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="phone_number" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="specialty" type="VARCHAR(255)"/>

            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <createIndex indexName="idx_mechanics_name"
                     tableName="mechanics">
            <column name="last_name"/>
            <column name="first_name"/>
        </createIndex>

    </changeSet>

    <changeSet id="7-add-partial-unique-index-mechanics-phone" author="MontassarTayari">

        <sql>
            CREATE UNIQUE INDEX uk_mechanics_phone_active
                ON mechanics (phone_number)
                WHERE deleted_at IS NULL;
        </sql>

    </changeSet>
</databaseChangeLog>