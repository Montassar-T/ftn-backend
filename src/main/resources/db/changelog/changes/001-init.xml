<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1-create-user-table" author="MontassarTayari">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="password" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(50)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="2-create-client-table" author="MontassarTayari">
        <createTable tableName="clients">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="phone_number" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="representative" type="VARCHAR(255)"/>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <createIndex indexName="idx_clients_phone_number" tableName="clients">
            <column name="phone_number"/>
        </createIndex>

        <createIndex indexName="idx_clients_name" tableName="clients">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="3-create-vehicle-makes-table" author="MontassarTayari">
        <createTable tableName="vehicle_makes">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="system_attribute" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <createIndex indexName="idx_vehicle_makes_name" tableName="vehicle_makes" unique="true">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="4-create-vehicle-models-table" author="MontassarTayari">
        <createTable tableName="vehicle_models">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="make_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="system_attribute" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="vehicle_models"
                baseColumnNames="make_id"
                referencedTableName="vehicle_makes"
                referencedColumnNames="id"
                constraintName="fk_vehicle_model_make"/>

        <createIndex indexName="idx_vehicle_models_make_id" tableName="vehicle_models">
            <column name="make_id"/>
        </createIndex>

        <createIndex indexName="idx_vehicle_models_name" tableName="vehicle_models">
            <column name="name"/>
        </createIndex>

        <sql>
            CREATE UNIQUE INDEX uk_vehicle_models_active
                ON vehicle_models (make_id, name)
                WHERE deleted_at IS NULL;
        </sql>
    </changeSet>

    <changeSet id="5-create-vehicle-table" author="MontassarTayari">
        <createTable tableName="vehicles">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="model_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="registration" type="VARCHAR(255)"/>

            <column name="mileage" type="INT"/>

            <column name="vin" type="VARCHAR(17)">
                <constraints unique="true"/>
            </column>

            <column name="registration_date" type="DATE"/>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="vehicles"
                baseColumnNames="model_id"
                referencedTableName="vehicle_models"
                referencedColumnNames="id"
                constraintName="fk_vehicle_model"/>

        <addForeignKeyConstraint
                baseTableName="vehicles"
                baseColumnNames="client_id"
                referencedTableName="clients"
                referencedColumnNames="id"
                constraintName="fk_vehicle_client_id"/>

        <createIndex indexName="idx_vehicle_client_id" tableName="vehicles">
            <column name="client_id"/>
        </createIndex>

        <createIndex indexName="idx_vehicle_model_id" tableName="vehicles">
            <column name="model_id"/>
        </createIndex>

        <createIndex indexName="idx_vehicle_vin" tableName="vehicles" unique="true">
            <column name="vin"/>
        </createIndex>
    </changeSet>

    <changeSet id="6-create-mechanics-table" author="MontassarTayari">

        <createTable tableName="mechanics">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="phone_number" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="specialty" type="VARCHAR(255)"/>

            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <createIndex indexName="idx_mechanics_name"
                     tableName="mechanics">
            <column name="last_name"/>
            <column name="first_name"/>
        </createIndex>

    </changeSet>

    <changeSet id="7-add-partial-unique-index-mechanics-phone" author="MontassarTayari">

        <sql>
            CREATE UNIQUE INDEX uk_mechanics_phone_active
                ON mechanics (phone_number)
                WHERE deleted_at IS NULL;
        </sql>

    </changeSet>

    <changeSet id="load-vehicle-makes" author="MontassarTayari">
        <loadUpdateData
                file="/db/changelog/data/make.csv"
                tableName="vehicle_makes"
                separator=";"
                primaryKey="id"
                quotchar="&quot;">
            <column name="name" type="STRING"/>
            <column name="system_attribute" type="BOOLEAN"/>
            <column name="id" type="STRING"/>

        </loadUpdateData>
    </changeSet>

    <changeSet id="load-vehicle-models" author="MontassarTayari">
        <loadUpdateData
                file="/db/changelog/data/model.csv"
                tableName="vehicle_models"
                separator=";"
                primaryKey="id"
                quotchar="&quot;">
            <column name="name" type="STRING"/>
            <column name="make_id" type="NUMERIC"/>
            <column name="system_attribute" type="BOOLEAN"/>
        </loadUpdateData>
    </changeSet>

    <changeSet id="insert-default-admin" author="MontassarTayari">

        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM users WHERE email = 'admin@car-services.tn'
            </sqlCheck>
        </preConditions>

        <insert tableName="users">

            <column name="email" value="admin@car-services.tn"/>
            <column name="first_name" value="Administrateur"/>
            <column name="last_name" value="Système"/>

            <column name="password"
                    value="$2a$10$.lZjRmb8skZbJUsCnlLgKOVUIUolRElhe8XmGM91yBcyYz6RzXuhO"/>

            <column name="role" value="ADMIN"/>

        </insert>

    </changeSet>

    <changeSet id="add-role-check-constraint-users" author="MontassarTayari">
        <sql>
            ALTER TABLE users
                ADD CONSTRAINT chk_users_role
                    CHECK (role IN ('ADMIN', 'EMPLOYEE'));
        </sql>
    </changeSet>

    <changeSet id="add-unaccent-extension" author="MontassarTayari">
        <sql>
            CREATE SCHEMA IF NOT EXISTS extensions;

            CREATE EXTENSION IF NOT EXISTS unaccent
        SCHEMA extensions;
        </sql>
    </changeSet>

    <changeSet id="5-create-repairs-table" author="MontassarTayari">
        <createTable tableName="repairs">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="vehicle_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="mechanic_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="mileage" type="INT"/>
            <column name="fuel_level" type="VARCHAR(50)"/>
            <column name="has_tools" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="has_spare_wheel" type="BOOLEAN" defaultValueBoolean="false"/>

            <!-- Dates -->
            <column name="scheduled_at" type="TIMESTAMP"/>
            <column name="received_at" type="TIMESTAMP"/>
            <column name="expected_delivery_at" type="TIMESTAMP"/>
            <column name="started_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="repairs"
                baseColumnNames="vehicle_id"
                constraintName="fk_repairs_vehicle"
                referencedTableName="vehicles"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="repairs"
                baseColumnNames="mechanic_id"
                constraintName="fk_repairs_mechanic"
                referencedTableName="mechanics"
                referencedColumnNames="id"/>

        <createIndex indexName="idx_repairs_vehicle_id"
                     tableName="repairs">
            <column name="vehicle_id"/>
        </createIndex>

        <createIndex indexName="idx_repairs_mechanic_id"
                     tableName="repairs">
            <column name="mechanic_id"/>
        </createIndex>

        <createIndex indexName="idx_repairs_status"
                     tableName="repairs">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_repairs_scheduled_at"
                     tableName="repairs">
            <column name="scheduled_at"/>
        </createIndex>

        <createIndex indexName="idx_repairs_received_at"
                     tableName="repairs">
            <column name="received_at"/>
        </createIndex>

        <createIndex indexName="idx_repairs_vehicle_status"
                     tableName="repairs">
            <column name="vehicle_id"/>
            <column name="scheduled_at"/>
        </createIndex>

        <sql>
            ALTER TABLE repairs
                ADD CONSTRAINT chk_repairs_fuel_level
                    CHECK (fuel_level IN ('EMPTY', 'QUARTER', 'HALF', 'THREE_QUARTERS', 'FULL'));
        </sql>

        <sql>
            ALTER TABLE repairs
                ADD CONSTRAINT chk_repairs_status
                    CHECK (status IN ('RDV', 'IN_PROGRESS', 'FINISHED', 'CANCELLED'));
        </sql>
    </changeSet>

    <changeSet id="add-missing-performance-indexes" author="MontassarTayari">

        <!-- VEHICLES -->
        <createIndex indexName="idx_vehicle_registration" tableName="vehicles">
            <column name="registration"/>
        </createIndex>

        <createIndex indexName="idx_vehicle_client_model" tableName="vehicles">
            <column name="client_id"/>
            <column name="model_id"/>
        </createIndex>

        <!-- CLIENTS -->
        <createIndex indexName="idx_clients_type" tableName="clients">
            <column name="type"/>
        </createIndex>

        <!-- MECHANICS -->
        <createIndex indexName="idx_mechanics_status" tableName="mechanics">
            <column name="status"/>
        </createIndex>

        <!-- REPAIRS -->
        <createIndex indexName="idx_repairs_status_created" tableName="repairs">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex indexName="idx_repairs_vehicle_created" tableName="repairs">
            <column name="vehicle_id"/>
            <column name="created_at"/>
        </createIndex>

    </changeSet>

    <changeSet id="8-create-activity-logs-table" author="montassar">

        <createTable tableName="activity_logs">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="action" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="entity_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="entity_id" type="BIGINT"/>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="metadata" type="TEXT"/>

            <!-- BaseEntity fields -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>

        </createTable>

        <!-- FK to users -->
        <addForeignKeyConstraint
                baseTableName="activity_logs"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_activity_logs_user"/>

        <!-- INDEXES (VERY IMPORTANT for logs filtering) -->

        <createIndex indexName="idx_activity_logs_user_id"
                     tableName="activity_logs">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_activity_logs_action"
                     tableName="activity_logs">
            <column name="action"/>
        </createIndex>

        <createIndex indexName="idx_activity_logs_entity"
                     tableName="activity_logs">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>

        <createIndex indexName="idx_activity_logs_created_at"
                     tableName="activity_logs">
            <column name="created_at"/>
        </createIndex>

    </changeSet>
    
    <changeSet id="reset-pk-seq-vehicle-makes" author="MontassarTayari">
        <sql>
            SELECT setval(
                           'vehicle_makes_id_seq',
                           (SELECT MAX(id) FROM vehicle_makes)
                   );
        </sql>
    </changeSet>

    <changeSet id="add-pgtrgm-extension" author="MontassarTayari">
        <sql>
            CREATE EXTENSION IF NOT EXISTS pg_trgm
        SCHEMA extensions;
        </sql>
    </changeSet>

</databaseChangeLog>