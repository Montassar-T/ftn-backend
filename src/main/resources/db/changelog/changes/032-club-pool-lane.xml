<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="032-club-pool-lane" author="ftn-dev">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="clubs" columnName="pool_id" />
            </not>
        </preConditions>
        <addColumn tableName="clubs">
            <column name="pool_id" type="BIGINT" />
            <column name="lane" type="INTEGER" />
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="clubs"
                baseColumnNames="pool_id"
                constraintName="fk_club_pool"
                referencedTableName="pools"
                referencedColumnNames="id" />
    </changeSet>

</databaseChangeLog>
