<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="021-1" author="AlainBx20">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="pool_schedules"/></not>
        </preConditions>
        <createTable tableName="pool_schedules">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pool_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_schedules_pool"
                             references="pools(id)"/>
            </column>
            <column name="purpose" type="VARCHAR(100)"/>
            <column name="start_date_time" type="TIMESTAMP"/>
            <column name="end_date_time" type="TIMESTAMP"/>
            <column name="status" type="VARCHAR(20)" defaultValue="SCHEDULED">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
