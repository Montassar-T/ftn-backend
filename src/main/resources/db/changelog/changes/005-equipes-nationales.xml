<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="5-create-equipes-nationales-table" author="MontassarTayari">
        <createTable tableName="equipes_nationales">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="discipline" type="VARCHAR(50)"/>

            <column name="categorie" type="VARCHAR(50)"/>

            <column name="annee" type="INT"/>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="modified_at" type="TIMESTAMP"/>

            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="5b-create-equipe-nationale-athletes-table" author="MontassarTayari">
        <createTable tableName="equipe_nationale_athletes">
            <column name="equipe_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_equipe_membre_equipe" references="equipes_nationales(id)"/>
            </column>

            <column name="athlete_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_equipe_membre_athlete" references="athletes(id)"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="equipe_nationale_athletes"
                       columnNames="equipe_id, athlete_id"
                       constraintName="pk_equipe_nationale_athletes"/>
    </changeSet>

</databaseChangeLog>
